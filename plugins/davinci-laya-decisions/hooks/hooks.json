{
  "description": "DaVinci × Laya: локальные типизированные решения в точках контроля ZCode (shadow-режим по умолчанию). Хуки с высокой частотой (pre/post-tool) идут через bin/laya-hook.exe: он пропускает запуск Node для явно читающих команд (ls/cat/git log/rg…), экономя ~0.2 c на событие; любое сомнение — проброс в Node без изменений.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|ApplyPatch",
        "hooks": [
          {
            "type": "process",
            "command": "${ZCODE_PLUGIN_ROOT}/bin/laya-hook.exe",
            "args": ["pre", "${ZCODE_PLUGIN_ROOT}/hooks/pre-tool.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Laya проверяет риск действия…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|ApplyPatch",
        "hooks": [
          {
            "type": "process",
            "command": "${ZCODE_PLUGIN_ROOT}/bin/laya-hook.exe",
            "args": ["post", "${ZCODE_PLUGIN_ROOT}/hooks/post-tool.mjs"],
            "timeoutMs": 3000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|ApplyPatch",
        "hooks": [
          {
            "type": "process",
            "command": "${ZCODE_PLUGIN_ROOT}/bin/laya-hook.exe",
            "args": ["post", "${ZCODE_PLUGIN_ROOT}/hooks/post-tool-failure.mjs"],
            "timeoutMs": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/stop.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Laya проверяет доказательства завершения…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/session-start.mjs"],
            "timeoutMs": 3000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/user-prompt.mjs"],
            "timeoutMs": 3000
          }
        ]
      }
    ]
  }
}
